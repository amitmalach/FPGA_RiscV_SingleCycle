# Firmware build outputs (firmware/Makefile writes everything under firmware/build/).
# The *.hex patterns stop stray image copies from reappearing beside the sources;
# the only tracked image is the one the RTL reads.
firmware/build/
firmware/*.hex
firmware/*.hex.*

# Scripted Vivado flow output (vivado/*.tcl) and sim builds
build/
